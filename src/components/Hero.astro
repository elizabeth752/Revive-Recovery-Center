---
import { hero } from "../data/home";
import { site } from "../config/site";
import InsuranceForm from "./InsuranceForm.astro";
---

<section class="relative bg-surface-muted overflow-hidden">
  <img
    src="/assets/images/Banner.webp"
    alt="Revive Recovery Center therapy office interior"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/55 to-white/0"></div>

  <div class="container-page relative py-10 sm:py-14 lg:py-20">
    <div class="grid lg:grid-cols-[1fr_460px] gap-10 lg:gap-12 items-center">
      <div class="text-center lg:text-left">
        <h1 class="text-[2.25rem] leading-[1.15] sm:text-[2.75rem] lg:text-[54px] lg:leading-[60px] max-w-[750px] mx-auto lg:mx-0">
          {hero.heading}
        </h1>

        <div class="flex items-center justify-center lg:justify-start gap-2 mt-4">
          <img src="/assets/icons/Stars-Desktop.svg" alt="" class="h-4 w-auto" aria-hidden="true" />
          <span class="text-[18px] font-semibold text-brand-primary">
            {site.rating.value}/{site.rating.outOf} on {site.rating.source} from {site.rating.reviewCount} reviews
          </span>
        </div>

        <p class="mt-4 font-medium text-text max-w-[750px] mx-auto lg:mx-0">{hero.subheading}</p>
        <p class="mt-3 text-[#0A1015] max-w-[750px] mx-auto lg:mx-0">{hero.body}</p>

        <ul class="mt-5 space-y-2.5 text-left max-w-[750px] mx-auto lg:mx-0">
          {
            hero.bullets.map((b) => (
              <li class="flex items-start gap-2.5">
                <svg class="shrink-0 mt-1" width="18" height="18" viewBox="0 0 24 24" fill="none">
                  <path d="M5 13l4 4L19 7" stroke="#335980" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="text-text">{b}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex flex-col items-center gap-3 lg:flex-row lg:flex-wrap lg:justify-start">
          <span class="inline-flex items-center gap-2 h-[45px] px-4 rounded-lg bg-brand-secondary text-brand-ink font-bold text-[20px]">
            <img src="/assets/icons/payment-plans.svg" alt="" class="h-[16px] w-auto" />
            Payment Plans Available
          </span>
          <div class="flex items-center gap-3">
            <img src="/assets/icons/joint-commission.svg" alt="Joint Commission accredited" class="h-[50px] w-[50px]" />
            <img src="/assets/icons/psychology-today.svg" alt="Verified by Psychology Today" class="h-[42px] w-auto" />
          </div>
        </div>
      </div>

      <InsuranceForm id="hero-insurance-form" class="hidden lg:block w-full max-w-[460px] mx-auto lg:mx-0 scroll-mt-32" />
    </div>
  </div>
</section>
