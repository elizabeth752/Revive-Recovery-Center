---
import { location } from "../data/home";
import { site } from "../config/site";
---

<section class="bg-brand-cream py-14 sm:py-16">
  <div class="container-page text-center">
    <h2 class="max-w-[1300px] mx-auto">{location.heading}</h2>
    <p class="mt-3 text-text max-w-[1283px] mx-auto">{location.body}</p>

    <div class="mt-8 grid sm:grid-cols-2 gap-4 max-w-[1080px] mx-auto text-left rounded-xl overflow-hidden items-stretch">
      <iframe
        title={`Map to ${site.name}`}
        src={`https://maps.google.com/maps?q=${encodeURIComponent(site.address.full)}&z=15&output=embed`}
        class="w-full h-full min-h-[260px] border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>

      <div class="bg-white rounded-xl overflow-hidden">
        <img src={location.facilityImage} alt={`${site.name} lobby`} class="w-full h-[200px] sm:h-[290px] object-cover" />
        <div class="p-4">
          <p class="text-[20px] font-black text-brand-primary">Revive Recovery Centers</p>
          <a href={site.address.mapsHref} target="_blank" rel="noopener" class="text-[18px] text-brand-primary underline">
            {site.address.full}
          </a>
          <p class="mt-2 text-[18px] text-text">{location.description}</p>
        </div>
      </div>
    </div>

    <a href={site.phoneHref} class="btn btn-secondary mt-8">Call Us Today</a>
  </div>
</section>
