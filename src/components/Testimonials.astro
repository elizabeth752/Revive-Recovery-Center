---
import { testimonials } from "../data/home";
---

<script>
  import { enableDragScroll } from "../scripts/dragScroll";
  document.querySelectorAll<HTMLElement>("[data-testimonials-scroll]").forEach(enableDragScroll);
</script>

<section class="bg-surface py-14 sm:py-20 overflow-hidden">
  <div class="container-page flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-14">
    <div class="lg:w-[627px] shrink-0">
      <h2>{testimonials.heading}</h2>
      <p class="mt-3 text-text">{testimonials.body}</p>
    </div>

    <div
      data-testimonials-scroll
      class="lg:max-w-[617px] overflow-x-auto pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
    >
      <div class="flex gap-4 w-max font-alt">
        {
          testimonials.items.map((t) => (
            <div class="w-[252px] shrink-0 bg-white p-5 shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
              <div class="flex items-center gap-3">
                <img src={t.avatar} alt="" class="w-9 h-9 rounded-full shrink-0 object-cover" />
                <div>
                  <p class="font-semibold text-[14px] leading-4">{t.name}</p>
                  <div class="flex items-center gap-1 text-brand-accent mt-1" aria-label="5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8l-6.2 3.3 1.2-6.9-5-4.9 6.9-1z"/></svg>
                    ))}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="text-brand-primary ml-0.5" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M8 12.5l2.5 2.5L16 9.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                </div>
              </div>
              <p class="mt-3 text-[14px] leading-[21px] text-text line-clamp-6">{t.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
