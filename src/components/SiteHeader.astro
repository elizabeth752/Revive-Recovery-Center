---
import Logo from "./Logo.astro";
import { site } from "../config/site";
import { subNav } from "../data/home";
---

<div class="bg-brand-secondary text-white text-center py-2 px-4 text-[18px] leading-snug">
  <span class="font-bold">{site.bannerAlert}</span>
  <span class="hidden sm:inline"> &ndash; </span>
  <span class="block sm:inline">⚠️ {site.bannerWarning}</span>
</div>

<div class="sticky top-0 z-50 shadow-sm">
  <header class="bg-brand-primary">
    <div class="container-page flex items-center justify-between py-3 sm:py-4">
      <Logo variant="light" />
      <a href={site.phoneHref} class="btn btn-primary !px-3 sm:!px-6 !text-[16px] sm:!text-[20px]">
        Call
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M20 13.8932V18.7785C20.0002 18.9467 19.9666 19.1132 19.9011 19.2681C19.8356 19.423 19.7396 19.5631 19.6188 19.6801C19.4081 19.885 19.1259 19.9998 18.8321 20C18.8157 20 18.7993 19.9996 18.7829 19.9988C13.8698 19.7891 9.21504 17.7401 5.74226 14.2584C2.26008 10.7854 0.210788 6.13029 0.00103145 1.21675C-0.00554 1.06312 0.0193423 0.909763 0.0741523 0.766089C0.128962 0.622416 0.212545 0.491453 0.319773 0.381233C0.436759 0.260427 0.576873 0.164413 0.73176 0.0989155C0.886647 0.0334179 1.05314 -0.000222088 1.2213 1.10336e-06H6.10669C6.39516 0.00122987 6.67363 0.105827 6.89157 0.294814C7.10952 0.4838 7.25249 0.744653 7.29455 1.03004L7.93984 5.54704C7.96574 5.73146 7.94857 5.91937 7.88968 6.09604C7.83079 6.27271 7.73177 6.43334 7.6004 6.56533L5.68446 8.48125C5.62077 8.54371 5.57962 8.62554 5.56745 8.7139C5.55529 8.80227 5.57281 8.89217 5.61726 8.96951C6.96958 11.1756 8.82459 13.0304 11.0308 14.3826C11.108 14.4269 11.1978 14.4443 11.286 14.4321C11.3742 14.42 11.4559 14.3789 11.5182 14.3154L13.4346 12.3995C13.5667 12.2683 13.7272 12.1694 13.9038 12.1105C14.0804 12.0516 14.2682 12.0344 14.4525 12.06L18.9696 12.7053C19.255 12.7473 19.516 12.8903 19.705 13.1082C19.8941 13.3261 19.9988 13.6047 20 13.8932Z"
            fill="currentColor"
          ></path>
        </svg>
        {site.phone}
      </a>
    </div>
  </header>
  <nav class="bg-surface border-b border-border" aria-label="Page sections">
    <div class="container-page flex items-center justify-center gap-6 sm:gap-10 py-3 overflow-x-auto text-[18px] text-[#0A1015]">
      {
        subNav.map((item, i) => (
          <a
            href={item.href}
            class:list={[
              "whitespace-nowrap pb-1 border-b-2 transition-colors",
              i === 0 ? "text-brand-primary border-brand-primary font-semibold" : "border-transparent hover:text-brand-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</div>

<script>
  // Native on-load hash scrolling is unreliable here: images loading in
  // below-the-fold sections shift layout after the browser's initial
  // scroll attempt, sometimes leaving the page at the top instead of the
  // requested section. Re-run the scroll once the page has fully settled.
  if (location.hash) {
    window.addEventListener("load", () => {
      document.querySelector(location.hash)?.scrollIntoView();
    });
  }
</script>
