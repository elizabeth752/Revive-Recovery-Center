---
import { difference } from "../data/home";
import { site } from "../config/site";
---

<script>
  import { enableDragScroll } from "../scripts/dragScroll";

  document.querySelectorAll<HTMLElement>("[data-diff-scroll]").forEach((scroller) => {
    enableDragScroll(scroller);

    const wrap = scroller.closest("[data-diff-carousel]");
    const prev = wrap?.querySelector<HTMLButtonElement>("[data-diff-prev]");
    const next = wrap?.querySelector<HTMLButtonElement>("[data-diff-next]");

    function cardStep() {
      const card = scroller.querySelector<HTMLElement>("[data-diff-slide]");
      const gap = 16; // matches gap-4
      return card ? card.getBoundingClientRect().width + gap : 260;
    }

    prev?.addEventListener("click", () => scroller.scrollBy({ left: -cardStep(), behavior: "smooth" }));
    next?.addEventListener("click", () => scroller.scrollBy({ left: cardStep(), behavior: "smooth" }));
  });
</script>

<section class="bg-surface py-14 sm:py-20">
  <div class="container-page">
    <div class="text-center max-w-[1080px] mx-auto">
      <h2>{difference.heading}</h2>
      <p class="mt-3 text-text">{difference.body}</p>
    </div>

    <!-- Mobile: horizontal carousel of standalone cards -->
    <div class="mt-10 sm:hidden" data-diff-carousel>
      <div
        class="flex gap-4 overflow-x-auto pb-2 snap-x snap-mandatory px-[var(--gutter-mobile)] -mx-[var(--gutter-mobile)] [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
        data-diff-scroll
      >
        {
          difference.cards.map((card) => (
            <div
              data-diff-slide
              class="shrink-0 basis-[78%] snap-center bg-white rounded-[10px] border border-border shadow-[0_4px_4px_rgba(0,0,0,0.15)] px-6 py-8 text-center"
            >
              <img src={card.icon} alt="" class="mx-auto w-[50px] h-[50px]" />
              <h3 class="mt-4 text-[20px] font-black text-brand-primary leading-tight">{card.title}</h3>
              <p class="mt-2 text-[16px] text-text">{card.body}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-6 flex items-center justify-center gap-4">
        <button
          type="button"
          data-diff-prev
          aria-label="Previous"
          class="w-9 h-9 rounded-full bg-brand-primary text-white flex items-center justify-center shadow"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button
          type="button"
          data-diff-next
          aria-label="Next"
          class="w-9 h-9 rounded-full bg-brand-primary text-white flex items-center justify-center shadow"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <!-- Desktop: divided two-column list -->
    <div class="mt-10 max-w-[1080px] mx-auto hidden sm:grid sm:grid-cols-2 gap-x-10">
      {
        difference.cards.map((card, i) => (
          <div
            class:list={[
              "flex items-start gap-4 py-5",
              i === 2 || i === 3 ? "border-b border-border" : "",
            ]}
          >
            <img src={card.icon} alt="" class="shrink-0 w-[70px] h-[70px]" />
            <div>
              <h3 class="text-[20px] font-black text-brand-primary leading-tight">{card.title}</h3>
              <p class="mt-1 text-[18px] text-text">{card.body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href={site.phoneHref} class="btn btn-secondary">Speak With Our Team</a>
    </div>
  </div>
</section>
