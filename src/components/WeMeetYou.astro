---
import { weMeetYou } from "../data/home";
import { site } from "../config/site";
---

<script>
  import { enableDragScroll } from "../scripts/dragScroll";
  document.querySelectorAll<HTMLElement>("[data-thumb-scroll]").forEach(enableDragScroll);
</script>

<section id="our-center" class="bg-brand-primary py-14 sm:py-20">
  <div class="container-page">
    <div class="text-center max-w-[1300px] mx-auto">
      <h2 class="text-white">{weMeetYou.heading}</h2>
      <p class="mt-3 text-white/90">{weMeetYou.body}</p>
    </div>

    <div class="mt-10 max-w-[1080px] mx-auto" data-gallery>
      <div class="relative">
        <div class="overflow-hidden rounded-xl" data-viewport>
          <div
            class="flex gap-5 cursor-grab active:cursor-grabbing select-none [-webkit-user-drag:none]"
            data-track
            style="touch-action: pan-y;"
          >
            {
              weMeetYou.gallery.map((src, i) => (
                <div class="shrink-0 basis-full sm:basis-[calc(50%-10px)] aspect-[5/3]" data-slide={i}>
                  <img
                    src={src}
                    alt={`${site.name} facility photo ${i + 1}`}
                    class="w-full h-full object-cover rounded-xl pointer-events-none [-webkit-user-drag:none]"
                    draggable="false"
                  />
                </div>
              ))
            }
          </div>
        </div>
        <button
          type="button"
          data-prev
          aria-label="Previous photo"
          class="absolute -left-6 lg:-left-9 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center text-brand-primary shadow"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button
          type="button"
          data-next
          aria-label="Next photo"
          class="absolute -right-6 lg:-right-9 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center text-brand-primary shadow"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="mt-3 flex sm:grid sm:grid-cols-6 gap-2 sm:gap-3 overflow-x-auto sm:overflow-visible" data-thumb-scroll>
        {
          weMeetYou.gallery.map((src, i) => (
            <button
              type="button"
              data-thumb={i}
              aria-label={`View photo ${i + 1}`}
              class:list={[
                "shrink-0 basis-[45%] sm:basis-auto sm:shrink h-20 w-full rounded-lg overflow-hidden border-2 transition-colors",
                i === 0 || i === 1 ? "border-white" : "border-transparent opacity-70 hover:opacity-100",
              ]}
            >
              <img src={src} alt="" class="w-full h-full object-cover" draggable="false" />
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-10 max-w-[1080px] mx-auto rounded-[10px] border border-white/10 bg-white/[0.12] px-[30px] py-[26px] shadow-[0_4px_4px_rgba(0,0,0,0.25)]">
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 gap-y-5 sm:gap-y-8 text-left">
        {
          weMeetYou.features.map((f) => (
            <div class="flex flex-row items-center gap-3 sm:flex-col sm:items-start">
              <span class="w-[50px] h-[50px] rounded-full bg-white flex items-center justify-center shrink-0">
                <img src={f.icon} alt="" class="w-[50px] h-[50px]" />
              </span>
              <p class="text-white text-[18px]">{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>("[data-track]");
    const viewport = gallery.querySelector<HTMLElement>("[data-viewport]");
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-slide]"));
    const thumbs = Array.from(gallery.querySelectorAll<HTMLElement>("[data-thumb]"));
    if (!track || !viewport || slides.length === 0) return;

    let current = 0;
    const gap = 20; // matches gap-5

    function slideWidth() {
      return slides[0].getBoundingClientRect().width;
    }

    // 1 slide visible on mobile, 2 on sm+ — derived from actual rendered
    // widths rather than hardcoded, so it tracks the responsive basis classes.
    function visibleCount() {
      const sw = slideWidth();
      if (!sw) return 1;
      return Math.max(1, Math.round((viewport!.clientWidth + gap) / (sw + gap)));
    }

    function maxIndex() {
      return Math.max(slides.length - visibleCount(), 0);
    }

    function offsetFor(index: number) {
      return index * (slideWidth() + gap);
    }

    function update() {
      current = Math.min(current, maxIndex());
      track!.style.transition = "transform 300ms ease";
      track!.style.transform = `translateX(-${offsetFor(current)}px)`;

      const visible = visibleCount();
      thumbs.forEach((t, i) => {
        const active = i >= current && i < current + visible;
        t.classList.toggle("border-white", active);
        t.classList.toggle("border-transparent", !active);
        t.classList.toggle("opacity-70", !active);
        t.classList.toggle("opacity-100", active);
      });
    }

    function show(index: number) {
      current = Math.min(Math.max(index, 0), maxIndex());
      update();
    }

    gallery.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1 < 0 ? maxIndex() : current - 1));
    gallery.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1 > maxIndex() ? 0 : current + 1));
    thumbs.forEach((t, i) => t.addEventListener("click", () => show(Math.min(i, maxIndex()))));
    window.addEventListener("resize", update);

    // Click-and-hold (mouse) / finger-drag (touch) support, unified via Pointer Events.
    let isDown = false;
    let startX = 0;
    let dragDelta = 0;

    function onPointerDown(e: PointerEvent) {
      isDown = true;
      startX = e.clientX;
      dragDelta = 0;
      track!.style.transition = "none";
      track!.setPointerCapture(e.pointerId);
      e.preventDefault();
    }

    function onPointerMove(e: PointerEvent) {
      if (!isDown) return;
      dragDelta = e.clientX - startX;
      track!.style.transform = `translateX(${-offsetFor(current) + dragDelta}px)`;
    }

    function onPointerUp(e: PointerEvent) {
      if (!isDown) return;
      isDown = false;
      try {
        track!.releasePointerCapture(e.pointerId);
      } catch {}
      const threshold = slideWidth() * 0.2;
      if (dragDelta < -threshold) {
        show(current + 1 > maxIndex() ? maxIndex() : current + 1);
      } else if (dragDelta > threshold) {
        show(current - 1 < 0 ? 0 : current - 1);
      } else {
        update();
      }
      dragDelta = 0;
    }

    track!.addEventListener("pointerdown", onPointerDown);
    track!.addEventListener("pointermove", onPointerMove);
    track!.addEventListener("pointerup", onPointerUp);
    track!.addEventListener("pointercancel", onPointerUp);

    update();
  });
</script>
