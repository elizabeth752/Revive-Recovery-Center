---
import { continuum } from "../data/home";
import { site } from "../config/site";
---

<section id="programs" class="bg-surface py-14 sm:py-20">
  <div class="container-page">
    <div class="text-center max-w-[1080px] mx-auto">
      <h2>{continuum.heading}</h2>
      <p class="mt-3 text-text">{continuum.body}</p>
    </div>

    <div class="mt-10 max-w-[1080px] mx-auto divide-y divide-border">
      {
        continuum.programs.map((program, i) => (
          <div
            class:list={[
              "grid gap-6 sm:gap-10 items-center py-8",
              i % 2 === 1 ? "sm:grid-cols-[1fr_330px]" : "sm:grid-cols-[330px_1fr]",
              i === 0 ? "pt-0" : "",
            ]}
          >
            <div class:list={["rounded-xl overflow-hidden h-[160px]", i % 2 === 1 ? "sm:order-2" : ""]}>
              <img src={program.image} alt={program.title} class="w-full h-full object-cover" />
            </div>
            <div class:list={i % 2 === 1 ? "sm:order-1" : ""}>
              <h3 class="font-alt font-semibold text-brand-primary text-[18px] leading-[22px]">{program.title}</h3>
              <p class="mt-2 text-text text-[18px]">{program.body}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-6 text-center">
      <a href={site.phoneHref} class="btn btn-secondary">Begin Treatment</a>
    </div>
  </div>
</section>
