---
import { faq } from "../data/home";
import { site } from "../config/site";
---

<section class="bg-surface py-14 sm:py-20">
  <div class="container-page max-w-[934px] mx-auto">
    <h2 class="text-center">{faq.heading}</h2>

    <div class="mt-8 space-y-4">
      {
        faq.items.map((item, i) => (
          <details class="group bg-brand-tertiary rounded-xl overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer text-white font-bold text-[20px] list-none">
              {item.q}
              <span class="relative shrink-0 w-5 h-5">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="absolute inset-0 group-open:hidden">
                  <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.4" />
                  <path d="M12 8v8M8 12h8" stroke="white" stroke-width="1.4" stroke-linecap="round" />
                </svg>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="absolute inset-0 hidden group-open:block">
                  <circle cx="12" cy="12" r="10" stroke="white" stroke-width="1.4" />
                  <path d="M8 12h8" stroke="white" stroke-width="1.4" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <div class="px-5 pb-5">
              <p class="bg-white rounded-lg p-4 text-[18px] text-text shadow-sm">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <h3 class="text-[24px] leading-[30px] font-black text-brand-primary">{faq.ctaHeading}<br />{faq.ctaSubheading}</h3>
      <a href={site.phoneHref} class="btn btn-primary mt-4">Call {site.phone}</a>
    </div>
  </div>
</section>
