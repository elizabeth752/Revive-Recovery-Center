    <Hero />
    <WeMeetYou />
    <RecoveryDifference />
    <GoodCare />
    <ProgramContinuum />
    <ConditionsCarousel />
    {/* TeamSection intentionally omitted — no approved staff data/photos yet. */}
    <InsuranceStrip />
    <StartingSteps />
    <Testimonials />
    <StandardOfCare />
    <LocationSection />
    <FAQSection />
    <MobileInsuranceSection />
